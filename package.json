{
  "name": "carbonledger",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise ESG, carbon accounting and sustainability intelligence platform",
  "packageManager": "pnpm@10.0.0",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "pnpm --parallel --filter @carbonledger/api --filter @carbonledger/web dev",
    "dev:api": "pnpm --filter @carbonledger/api dev",
    "dev:web": "pnpm --filter @carbonledger/web dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @carbonledger/api exec prisma generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @carbonledger/api exec prisma migrate dev",
    "db:studio": "dotenv -e .env -- pnpm --filter @carbonledger/api exec prisma studio",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0"
  }
}
