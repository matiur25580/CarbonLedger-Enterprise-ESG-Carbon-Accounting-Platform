# Local development only. Never commit real credentials.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# Migration connection: local postgres admin; use a dedicated migration role in production.
DATABASE_URL=postgresql://postgres:postgres_dev@localhost:5432/carbonledger?schema=public
# Application connection: restricted role with no BYPASSRLS or table ownership.
APP_DATABASE_URL=postgresql://carbonledger_app:carbonledger_app_dev@localhost:5432/carbonledger?schema=public
JWT_ACCESS_SECRET=local-development-only-change-this-secret-before-deployment
COOKIE_SECURE=false
VITE_API_BASE_URL=http://localhost:4000/api/v1
