# Local development only. Never commit real credentials.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# Bootstrap/admin connection: used only for local role provisioning and test cleanup.
DATABASE_ADMIN_URL=postgresql://postgres:postgres_dev@localhost:5432/carbonledger?schema=public
# Migration connection: dedicated non-superuser role; CREATEDB is for local Prisma migrate dev shadow databases.
DATABASE_URL=postgresql://carbonledger_migrator:carbonledger_migrator_dev@localhost:5432/carbonledger?schema=public
# Application connection: no superuser, no BYPASSRLS, and no table ownership.
APP_DATABASE_URL=postgresql://carbonledger_app:carbonledger_app_dev@localhost:5432/carbonledger?schema=public
JWT_ACCESS_SECRET=local-development-only-change-this-secret-before-deployment
# Optional until webhook endpoints are enabled. Generate with: openssl rand -hex 32
WEBHOOK_ENCRYPTION_KEY=
COOKIE_SECURE=false
VITE_API_BASE_URL=http://localhost:4000/api/v1
