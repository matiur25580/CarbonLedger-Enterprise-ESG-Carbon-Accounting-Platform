generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  AUDITOR
}

enum ActivityCategory {
  ELECTRICITY
  NATURAL_GAS
  DIESEL
  PETROL
  LPG
  REFRIGERANTS
  COMPANY_VEHICLES
  BUSINESS_TRAVEL
  WASTE
  WATER
  PURCHASED_GOODS
  FREIGHT
  OTHER
}

enum EmissionScope {
  SCOPE_1
  SCOPE_2
  SCOPE_3
}

enum ActivityStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum EmissionFactorStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ActivityImportStatus {
  COMMITTED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum SupplierSubmissionStatus {
  SUBMITTED
}

enum SupplierReviewDecision {
  APPROVED
  REJECTED
  NEEDS_CHANGES
}

enum InitiativeStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

model User {
  id            String                   @id @default(uuid()) @db.Uuid
  name          String                   @db.VarChar(100)
  email         String                   @unique @db.VarChar(254)
  passwordHash  String                   @map("password_hash") @db.VarChar(255)
  status        UserStatus               @default(ACTIVE)
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  memberships   OrganizationMembership[]
  refreshTokens RefreshToken[]
  auditEvents   AuditLog[]               @relation("AuditActor")
  facilitiesCreated Facility[]           @relation("FacilityCreator")
  activitiesCreated ActivityRecord[]     @relation("ActivityCreator")
  activitiesReviewed ActivityRecord[]    @relation("ActivityReviewer")
  calculationRunsCreated CalculationRun[] @relation("CalculationCreator")
  factorsCreated EmissionFactor[]        @relation("FactorCreator")
  activityImports ActivityImportBatch[]  @relation("ActivityImportCreator")
  supplierReviews SupplierSubmissionReview[] @relation("SupplierSubmissionReviewer")
  supplierEvidenceUploads SupplierEvidence[] @relation("SupplierEvidenceUploader")
  supplierEvidenceReviews SupplierEvidenceReview[] @relation("SupplierEvidenceReviewer")
  webhookEndpointsCreated WebhookEndpoint[] @relation("WebhookEndpointCreator")

  @@map("users")
}

model Organization {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String                   @db.VarChar(160)
  slug        String                   @unique @db.VarChar(80)
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  memberships OrganizationMembership[]
  auditEvents AuditLog[]
  refreshTokens RefreshToken[]
  facilities    Facility[]
  activities    ActivityRecord[]
  emissionFactors EmissionFactor[]
  calculationRuns CalculationRun[]
  calculationResults CalculationResult[]
  activityImports ActivityImportBatch[]
  suppliers Supplier[]
  supplierQuestionnaires SupplierQuestionnaire[]
  supplierInvitations SupplierInvitation[]
  supplierInvitationEmails SupplierInvitationEmail[]
  supplierSubmissions SupplierSubmission[]
  supplierEvidence SupplierEvidence[]
  supplierEvidenceReviews SupplierEvidenceReview[]
  supplierSubmissionReviews SupplierSubmissionReview[]
  reductionTargets ReductionTarget[]
  reductionInitiatives ReductionInitiative[]
  reductionScenarios ReductionScenario[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]

  @@map("organizations")
}

model OrganizationMembership {
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           OrgRole      @default(MEMBER)
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId, createdAt])
  @@map("organization_memberships")
}

model RefreshToken {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String       @map("user_id") @db.Uuid
  organizationId      String       @map("organization_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash") @db.Char(64)
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash") @db.Char(64)
  createdAt           DateTime  @default(now()) @map("created_at")
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id           String       @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  actorUserId  String?      @map("actor_user_id") @db.Uuid
  action       String       @db.VarChar(120)
  resourceType String       @map("resource_type") @db.VarChar(80)
  resourceId   String       @map("resource_id") @db.VarChar(120)
  metadata     Json?
  createdAt    DateTime     @default(now()) @map("created_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, resourceType, resourceId])
  @@map("audit_logs")
}

model Facility {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  code            String       @db.VarChar(40)
  name            String       @db.VarChar(160)
  countryCode     String       @map("country_code") @db.Char(2)
  region          String?      @db.VarChar(120)
  city            String?      @db.VarChar(120)
  addressLine1    String?      @map("address_line_1") @db.VarChar(200)
  timezone        String       @default("UTC") @db.VarChar(80)
  isActive        Boolean      @default(true) @map("is_active")
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy       User         @relation("FacilityCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  activities      ActivityRecord[]
  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, isActive, name])
  @@map("facilities")
}

model ActivityRecord {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  facilityId       String           @map("facility_id") @db.Uuid
  category         ActivityCategory
  scope            EmissionScope
  quantity         Decimal          @db.Decimal(20, 6)
  unit             String           @db.VarChar(40)
  periodStart      DateTime         @map("period_start") @db.Date
  periodEnd        DateTime         @map("period_end") @db.Date
  sourceName       String           @map("source_name") @db.VarChar(160)
  sourceReference  String?          @map("source_reference") @db.VarChar(240)
  notes            String?          @db.VarChar(2000)
  status           ActivityStatus   @default(DRAFT)
  createdByUserId  String           @map("created_by_user_id") @db.Uuid
  reviewedByUserId String?          @map("reviewed_by_user_id") @db.Uuid
  submittedAt      DateTime?        @map("submitted_at")
  reviewedAt       DateTime?        @map("reviewed_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facility         Facility         @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy        User             @relation("ActivityCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedBy       User?            @relation("ActivityReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  calculationResults CalculationResult[]
  importBatchId   String? @map("import_batch_id") @db.Uuid
  importBatch     ActivityImportBatch? @relation(fields: [importBatchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, periodStart, periodEnd])
  @@unique([id, organizationId])
  @@index([organizationId, facilityId, category, status])
  @@index([organizationId, importBatchId])
  @@map("activity_records")
}

model ActivityImportBatch {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  createdByUserId String              @map("created_by_user_id") @db.Uuid
  fileName        String              @map("file_name") @db.VarChar(180)
  contentSha256   String              @map("content_sha256") @db.Char(64)
  status          ActivityImportStatus @default(COMMITTED)
  totalRows       Int                 @map("total_rows")
  importedRows    Int                 @map("imported_rows")
  report          Json
  createdAt       DateTime            @default(now()) @map("created_at")
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy       User                @relation("ActivityImportCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  activities      ActivityRecord[]

  @@unique([id, organizationId])
  @@unique([organizationId, contentSha256])
  @@index([organizationId, createdAt])
  @@map("activity_import_batches")
}


model Supplier {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String         @db.VarChar(180)
  contactName    String         @map("contact_name") @db.VarChar(120)
  contactEmail   String         @map("contact_email") @db.VarChar(254)
  countryCode    String         @map("country_code") @db.Char(2)
  website        String?        @db.VarChar(300)
  category       String         @db.VarChar(100)
  status         SupplierStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitations    SupplierInvitation[]
  submissions    SupplierSubmission[]
  @@unique([id, organizationId])
  @@unique([organizationId, contactEmail])
  @@index([organizationId, status, name])
  @@map("suppliers")
}

model SupplierQuestionnaire {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  title          String       @db.VarChar(180)
  description    String?      @db.VarChar(2000)
  version        Int          @default(1)
  questions      Json
  isPublished    Boolean      @default(false) @map("is_published")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitations    SupplierInvitation[]
  submissions    SupplierSubmission[]
  @@unique([id, organizationId])
  @@unique([organizationId, title, version])
  @@index([organizationId, isPublished, createdAt])
  @@map("supplier_questionnaires")
}

model SupplierInvitation {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  supplierId      String                @map("supplier_id") @db.Uuid
  questionnaireId String                @map("questionnaire_id") @db.Uuid
  tokenHash       String                @unique @map("token_hash") @db.Char(64)
  expiresAt       DateTime              @map("expires_at")
  usedAt          DateTime?             @map("used_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier        Supplier              @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  questionnaire   SupplierQuestionnaire @relation(fields: [questionnaireId, organizationId], references: [id, organizationId], onDelete: Restrict)
  submission      SupplierSubmission?
  emailDelivery   SupplierInvitationEmail?
  @@unique([id, organizationId])
  @@index([organizationId, supplierId, expiresAt])
  @@map("supplier_invitations")
}

model SupplierSubmission {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  supplierId      String                  @map("supplier_id") @db.Uuid
  questionnaireId String                  @map("questionnaire_id") @db.Uuid
  invitationId    String                  @unique @map("invitation_id") @db.Uuid
  status          SupplierSubmissionStatus @default(SUBMITTED)
  answers         Json
  submittedAt     DateTime                @default(now()) @map("submitted_at")
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier        Supplier                 @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  questionnaire   SupplierQuestionnaire    @relation(fields: [questionnaireId, organizationId], references: [id, organizationId], onDelete: Restrict)
  invitation      SupplierInvitation       @relation(fields: [invitationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  evidence         SupplierEvidence[]
  reviews          SupplierSubmissionReview[]
  @@unique([id, organizationId])
  @@unique([invitationId, organizationId])
  @@index([organizationId, supplierId, submittedAt])
  @@map("supplier_submissions")
}

model EmissionFactor {
  id                 String               @id @default(uuid()) @db.Uuid
  organizationId     String               @map("organization_id") @db.Uuid
  code               String               @db.VarChar(80)
  version            Int                  @default(1)
  name               String               @db.VarChar(180)
  category           ActivityCategory
  scope              EmissionScope
  unit               String               @db.VarChar(40)
  geographyCode      String               @map("geography_code") @db.VarChar(12)
  kgCo2ePerUnit      Decimal              @map("kg_co2e_per_unit") @db.Decimal(24, 12)
  sourceName         String               @map("source_name") @db.VarChar(180)
  sourceUrl          String?              @map("source_url") @db.VarChar(500)
  sourceVersion      String               @map("source_version") @db.VarChar(80)
  methodology        String               @db.VarChar(2000)
  uncertaintyPercent Decimal?             @map("uncertainty_percent") @db.Decimal(7, 4)
  validFrom          DateTime             @map("valid_from") @db.Date
  validTo            DateTime?            @map("valid_to") @db.Date
  status             EmissionFactorStatus @default(DRAFT)
  createdByUserId    String               @map("created_by_user_id") @db.Uuid
  publishedAt        DateTime?            @map("published_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy          User                 @relation("FactorCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code, version])
  @@unique([id, organizationId])
  @@index([organizationId, category, geographyCode, status])
  @@index([organizationId, validFrom, validTo])
  calculationResults CalculationResult[]

  @@map("emission_factors")
}

model CalculationRun {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  fingerprint     String   @db.Char(64)
  engineVersion   String   @map("engine_version") @db.VarChar(40)
  requestedCount  Int      @map("requested_count")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy       User @relation("CalculationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  results         CalculationResult[]

  @@unique([id, organizationId])
  @@unique([organizationId, fingerprint])
  @@index([organizationId, createdAt])
  @@map("calculation_runs")
}

model CalculationResult {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  calculationRunId     String   @map("calculation_run_id") @db.Uuid
  activityRecordId     String   @map("activity_record_id") @db.Uuid
  emissionFactorId     String   @map("emission_factor_id") @db.Uuid
  activityQuantity     Decimal  @map("activity_quantity") @db.Decimal(20, 6)
  activityUnit         String   @map("activity_unit") @db.VarChar(40)
  normalizedQuantity  Decimal  @map("normalized_quantity") @db.Decimal(30, 12)
  factorUnit           String   @map("factor_unit") @db.VarChar(40)
  conversionMultiplier Decimal  @map("conversion_multiplier") @db.Decimal(30, 18)
  conversionPath       Json     @map("conversion_path")
  factorValue          Decimal  @map("factor_value") @db.Decimal(24, 12)
  kgCo2e               Decimal  @map("kg_co2e") @db.Decimal(38, 18)
  snapshot             Json
  createdAt            DateTime @default(now()) @map("created_at")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  run                  CalculationRun @relation(fields: [calculationRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  activity             ActivityRecord @relation(fields: [activityRecordId, organizationId], references: [id, organizationId], onDelete: Restrict)
  factor               EmissionFactor @relation(fields: [emissionFactorId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([calculationRunId, activityRecordId])
  @@index([organizationId, activityRecordId, createdAt])
  @@map("calculation_results")
}


model SupplierEvidence {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  submissionId       String   @map("submission_id") @db.Uuid
  uploadedByUserId   String   @map("uploaded_by_user_id") @db.Uuid
  fileName           String   @map("file_name") @db.VarChar(240)
  mediaType          String   @map("media_type") @db.VarChar(120)
  byteSize           BigInt   @map("byte_size")
  sha256             String   @db.Char(64)
  storageProvider    String   @map("storage_provider") @db.VarChar(40)
  objectKey          String   @map("object_key") @db.VarChar(500)
  description        String?  @db.VarChar(1000)
  createdAt          DateTime @default(now()) @map("created_at")
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  submission         SupplierSubmission @relation(fields: [submissionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  uploadedBy         User @relation("SupplierEvidenceUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  reviews            SupplierEvidenceReview[]
  @@unique([id, organizationId])
  @@unique([organizationId, storageProvider, objectKey])
  @@index([organizationId, submissionId, createdAt])
  @@map("supplier_evidence")
}


model SupplierEvidenceReview {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  evidenceId       String @map("evidence_id") @db.Uuid
  submissionId     String @map("submission_id") @db.Uuid
  reviewerUserId   String @map("reviewer_user_id") @db.Uuid
  decision         SupplierReviewDecision
  comment          String? @db.VarChar(2000)
  createdAt        DateTime @default(now()) @map("created_at")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  evidence         SupplierEvidence @relation(fields: [evidenceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  reviewer         User @relation("SupplierEvidenceReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  @@unique([id, organizationId])
  @@index([organizationId, evidenceId, createdAt])
  @@index([organizationId, submissionId, createdAt])
  @@map("supplier_evidence_reviews")
}

model SupplierSubmissionReview {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  submissionId     String @map("submission_id") @db.Uuid
  reviewerUserId   String @map("reviewer_user_id") @db.Uuid
  decision         SupplierReviewDecision
  comment          String? @db.VarChar(2000)
  createdAt        DateTime @default(now()) @map("created_at")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  submission       SupplierSubmission @relation(fields: [submissionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  reviewer         User @relation("SupplierSubmissionReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  @@unique([id, organizationId])
  @@index([organizationId, submissionId, createdAt])
  @@map("supplier_submission_reviews")
}


model ReductionTarget {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  name                  String   @db.VarChar(180)
  scope                 EmissionScope
  baselineYear          Int      @map("baseline_year")
  targetYear            Int      @map("target_year")
  baselineKgCo2e        Decimal  @map("baseline_kg_co2e") @db.Decimal(38, 18)
  reductionPercent      Decimal  @map("reduction_percent") @db.Decimal(7, 4)
  createdByUserId       String   @map("created_by_user_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  initiatives           ReductionInitiative[]
  scenarios             ReductionScenario[]
  @@unique([id, organizationId])
  @@index([organizationId, targetYear])
  @@map("reduction_targets")
}

model ReductionInitiative {
  id                       String @id @default(uuid()) @db.Uuid
  organizationId           String @map("organization_id") @db.Uuid
  targetId                 String @map("target_id") @db.Uuid
  name                     String @db.VarChar(180)
  description              String? @db.VarChar(2000)
  status                   InitiativeStatus @default(PLANNED)
  expectedAnnualReductionKg Decimal @map("expected_annual_reduction_kg") @db.Decimal(38, 18)
  startDate                DateTime? @map("start_date") @db.Date
  endDate                  DateTime? @map("end_date") @db.Date
  createdByUserId          String @map("created_by_user_id") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  target                   ReductionTarget @relation(fields: [targetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@unique([id, organizationId])
  @@index([organizationId, targetId, status])
  @@map("reduction_initiatives")
}

model ReductionScenario {
  id                    String @id @default(uuid()) @db.Uuid
  organizationId        String @map("organization_id") @db.Uuid
  targetId              String @map("target_id") @db.Uuid
  name                  String @db.VarChar(180)
  baselineKgCo2e        Decimal @map("baseline_kg_co2e") @db.Decimal(38, 18)
  plannedReductionKg    Decimal @map("planned_reduction_kg") @db.Decimal(38, 18)
  projectedKgCo2e       Decimal @map("projected_kg_co2e") @db.Decimal(38, 18)
  targetKgCo2e          Decimal @map("target_kg_co2e") @db.Decimal(38, 18)
  assumptions           Json
  createdByUserId       String @map("created_by_user_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  target                ReductionTarget @relation(fields: [targetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@unique([id, organizationId])
  @@index([organizationId, targetId, createdAt])
  @@map("reduction_scenarios")
}


model WebhookEndpoint {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  url               String   @db.VarChar(2048)
  eventTypes        String[] @map("event_types")
  secretCiphertext  String   @map("secret_ciphertext") @db.Text
  secretIv          String   @map("secret_iv") @db.Char(24)
  secretAuthTag     String   @map("secret_auth_tag") @db.Char(32)
  enabled           Boolean  @default(true)
  createdByUserId   String   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy         User @relation("WebhookEndpointCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  deliveries        WebhookDelivery[]
  @@unique([id, organizationId])
  @@index([organizationId, enabled, createdAt])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  endpointId        String   @map("endpoint_id") @db.Uuid
  eventId           String   @map("event_id") @db.Uuid
  eventType         String   @map("event_type") @db.VarChar(120)
  payload           Json
  status            WebhookDeliveryStatus @default(PENDING)
  attempts          Int      @default(0)
  nextAttemptAt     DateTime @default(now()) @map("next_attempt_at")
  lockedAt          DateTime? @map("locked_at")
  responseStatus    Int?     @map("response_status")
  lastError         String?  @map("last_error") @db.VarChar(1000)
  deliveredAt       DateTime? @map("delivered_at")
  createdAt         DateTime @default(now()) @map("created_at")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  endpoint          WebhookEndpoint @relation(fields: [endpointId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@unique([id, organizationId])
  @@index([status, nextAttemptAt, createdAt])
  @@index([organizationId, endpointId, createdAt])
  @@index([eventId])
  @@map("webhook_deliveries")
}

model EvidenceScanJob {
